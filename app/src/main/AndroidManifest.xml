<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets Shizuku talk to this app. Merged in by the :provider AAR too; kept explicit. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Package visibility (Android 11+): needed to detect whether Shizuku is installed. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TetherBridge">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.TetherBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku integration point. This ContentProvider is how Shizuku
             delivers its Binder to the app. No <service> element is declared
             for TetherUserService on purpose: the Shizuku server starts the
             UserService itself from the class name in UserServiceArgs, and the
             official Shizuku demo manifest declares no <service> either. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
